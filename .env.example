# Run python scripts\configure.py to create .env with random secrets.
# Required PostgreSQL metadata URL, password >=16 chars, no SQLite fallback.
MODELBRIDGE_DATABASE_URL=
# Required comma-separated Fernet keys, newest first. modelbridge keygen generates one.
MODELBRIDGE_ENCRYPTION_KEYS=
# Compose metadata database password; generated by configure.py.
MODELBRIDGE_DB_PASSWORD=
# development | test | production (production additionally requires TLS verify-full)
MODELBRIDGE_ENVIRONMENT=development
# JSON array of explicit frontend origins; no wildcard.
MODELBRIDGE_CORS_ORIGINS=["http://localhost:3000"]
MODELBRIDGE_WORKER_ID=worker-1
MODELBRIDGE_HEARTBEAT_SECONDS=5
MODELBRIDGE_WORKER_STALE_SECONDS=30
# Account registration is operator opt-in; disable after provisioning users.
MODELBRIDGE_REGISTRATION_ENABLED=false
MODELBRIDGE_SESSION_SECONDS=3600
# Every DNS answer must belong to an explicitly allowed database CIDR.
# Empty denies external connection configuration/testing/discovery.
MODELBRIDGE_ALLOWED_DATABASE_NETWORKS=[]
MODELBRIDGE_CONNECTION_TIMEOUT_SECONDS=5
MODELBRIDGE_MAX_CONNECTIONS_PER_WORKSPACE=10
MODELBRIDGE_SCHEMA_DISCOVERIES_PER_MINUTE=5
# PostgreSQL-backed durable queue; no Redis required.
MODELBRIDGE_MAX_BATCH_SIZE=100
MODELBRIDGE_MAX_ACTIVE_JOBS_PER_WORKSPACE=2
MODELBRIDGE_JOB_RETRY_LIMIT=3
# Separate webhook egress allowlist. Empty disables outbound deliveries.
MODELBRIDGE_ALLOWED_WEBHOOK_NETWORKS=[]
MODELBRIDGE_MAX_REQUEST_BYTES=65536
MODELBRIDGE_REQUESTS_PER_MINUTE=120
# Shared direct-client-IP quota; forwarded headers are deliberately ignored.
MODELBRIDGE_ANONYMOUS_REQUESTS_PER_MINUTE=30
# Server-only dashboard proxy target; never supplied by browser requests.
MODELBRIDGE_API_URL=http://127.0.0.1:8000
# Optional host loopback bindings for Docker Compose.
MODELBRIDGE_API_BIND_PORT=8000
MODELBRIDGE_DASHBOARD_BIND_PORT=3000
# Optional tests only: both must be explicitly configured to run database integration tests.
# MODELBRIDGE_TEST_DATABASE_URL=
# MODELBRIDGE_TEST_ALLOW_DATABASE_WRITES=true
